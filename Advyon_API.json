	"item": [
		{
			"name": "Auth Module",
			"item": [
				{
					"name": "Sync User (First Login)",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// This endpoint syncs user from Clerk on first login",
									"// The clerkUserId and email come from the JWT token",
									"// No body is required - data is extracted from auth header"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200 or 201', function () {",
									"    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
									"});",
									"",
									"pm.test('Response has success and data', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData).to.have.property('success');",
									"    pm.expect(jsonData).to.have.property('data');",
									"});",
									"",
									"// Save user ID for later requests",
									"if (pm.response.code === 200 || pm.response.code === 201) {",
									"    var jsonData = pm.response.json();",
									"    pm.environment.set('userId', jsonData.data.id);",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clerkToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/auth/sync",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "auth", "sync"]
						},
						"description": "Syncs user from Clerk JWT on first login. Requires Clerk authentication token."
					},
					"response": []
				},
				{
					"name": "Onboard User - Client",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate client onboarding data",
									"const clientData = {",
									"    role: 'client',",
									"    profile: {",
									"        fullName: pm.variables.replaceIn('{{$randomFullName}}'),",
									"        displayName: pm.variables.replaceIn('{{$randomFirstName}}'),",
									"        phone: '+1' + Math.floor(Math.random() * 9000000000 + 1000000000),",
									"        avatarUrl: 'https://i.pravatar.cc/150?img=' + Math.floor(Math.random() * 70),",
									"        preferredLanguage: 'en',",
									"        timezone: 'America/New_York',",
									"        address: pm.variables.replaceIn('{{$randomStreetAddress}}, {{$randomCity}}, {{$randomCountry}}')",
									"    }",
									"};",
									"",
									"pm.environment.set('clientOnboardData', JSON.stringify(clientData));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 200', function () {",
									"    pm.response.to.have.status(200);",
									"});",
									"",
									"pm.test('User is onboarded successfully', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data.needsOnboarding).to.be.false;",
									"});"
								],
								"type": "text/javascript"
