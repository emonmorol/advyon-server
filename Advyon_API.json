		{
			"name": "Case Module",
			"item": [
				{
					"name": "Create Case",
					"event": [
						{
							"listen": "prerequest",
							"script": {
								"exec": [
									"// Generate case data",
									"const caseTypes = ['Criminal Defense', 'Civil Litigation', 'Corporate Law', 'Family Law', 'Immigration', 'Intellectual Property', 'Real Estate', 'Tax Law', 'Employment Law', 'Environmental Law'];",
									"const urgencyLevels = ['low', 'medium', 'high'];",
									"",
									"const caseData = {",
									"    title: pm.variables.replaceIn('{{$randomWords}}') + ' Case',",
									"    caseNumber: 'CASE-' + new Date().getFullYear() + '-' + Math.floor(Math.random() * 90000 + 10000),",
									"    caseType: caseTypes[Math.floor(Math.random() * caseTypes.length)],",
									"    urgency: urgencyLevels[Math.floor(Math.random() * urgencyLevels.length)],",
									"    nextDeadline: new Date(Date.now() + Math.floor(Math.random() * 30) * 24 * 60 * 60 * 1000).toISOString(),",
									"    nextDeadlineDescription: 'File initial response',",
									"    folders: [",
									"        { name: 'Evidence', order: 0 },",
									"        { name: 'Witness Statements', order: 1 },",
									"        { name: 'Legal Documents', order: 2 },",
									"        { name: 'Correspondence', order: 3 }",
									"    ]",
									"};",
									"",
									"pm.environment.set('createCaseData', JSON.stringify(caseData));"
								],
								"type": "text/javascript"
							}
						},
						{
							"listen": "test",
							"script": {
								"exec": [
									"pm.test('Status code is 201', function () {",
									"    pm.response.to.have.status(201);",
									"});",
									"",
									"pm.test('Case created successfully', function () {",
									"    var jsonData = pm.response.json();",
									"    pm.expect(jsonData.success).to.be.true;",
									"    pm.expect(jsonData.data).to.have.property('id');",
									"    pm.expect(jsonData.data).to.have.property('caseNumber');",
									"    ",
									"    // Save case ID for later requests",
									"    pm.environment.set('caseId', jsonData.data.id);",
									"});"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{clerkToken}}",
								"type": "text"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{{createCaseData}}",
							"options": {
								"raw": {
									"language": "json"
								}
							}
						},
						"url": {
							"raw": "{{base_url}}/api/v1/cases",
							"host": ["{{base_url}}"],
							"path": ["api", "v1", "cases"]
						},
						"description": "Create a new case with folders"
					},
					"response": []
				},
